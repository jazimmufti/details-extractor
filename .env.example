# ==========================================
# YouTube Social & Contact Intelligence System
# Environment Configuration
# ==========================================

# Google YouTube Data API v3 Key (Obtain from Google Cloud Console)
YOUTUBE_API_KEY=

# Google Gemini API Key (Obtain from Google AI Studio / Makersuite)
GEMINI_API_KEY=

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Optional CORS Origins (comma-separated or * for all)
CORS_ORIGINS=*

# Meta / Instagram Official Messaging API Settings
# (Obtain from Meta for Developers: App Dashboard -> Instagram Graph API / Messenger API for Instagram)
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
META_GRAPH_API_VERSION=v21.0
META_WEBHOOK_VERIFY_TOKEN=creator_outreach_verify_token

